  else:
  	global xPPerchDejada = xPPerchDejada_array[0]
  end
  
  
  if Rec_CapasTrab[Programa_1-1] == True:
  	Rec_TipoCapa = [1, 2, 1, 2, 1, 2, 1, 2, 1, 2, 1, 2, 1, 2, 1, 2, 1, 2, 1, 2, 1, 2, 1, 2, 1, 2, 1, 2, 1, 2]
  
  else:
