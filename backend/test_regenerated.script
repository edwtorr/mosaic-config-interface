  local j = 0
  
  yPPerchDejada_min_array = [1,1]
  yPPerchDejada_max_array = [0,0]
  xPPerchDejada_array = [1,1]
  
  local punto_aux = P_Tipo1[j]
  yPPerchDejada_min_array[0] = punto_aux[1]
  yPPerchDejada_max_array[0] = punto_aux[1]
  xPPerchDejada_array[0] = punto_aux[0]
  
   while j < Rec_NMovsCapa[Programa_1-1]:
   #while j < 15:
      if punto_aux[1] < yPPerchDejada_min_array[0]:
          yPPerchDejada_min_array[0] = punto_aux[1]
      end
      if punto_aux[1] > yPPerchDejada_max_array[0]:
          yPPerchDejada_max_array[0] = punto_aux[1]
      end
      if punto_aux[0] < xPPerchDejada_array[0]:
         xPPerchDejada_array[0] = punto_aux[0]
      end
      j = j + 1
      punto_aux = P_Tipo1[j]
      sleep(0.01)
  end
  
  if Rec_CapasTrab[Programa_1-1]:
  
  	j = 0
  
  	punto_aux = P_Tipo2[j]
  	yPPerchDejada_min_array[1] = punto_aux[1]
  	yPPerchDejada_max_array[1] = punto_aux[1]
  	xPPerchDejada_array[1] = punto_aux[0]
  
  	while j < Rec_NMovsCapa[Programa_1-1]:
  #while j < 15:
      		if punto_aux[1] < yPPerchDejada_min_array[1]:
          			yPPerchDejada_min_array[1] = punto_aux[1]
      		end
      		if punto_aux[1] > yPPerchDejada_max_array[1]:
          			yPPerchDejada_max_array[1] = punto_aux[1]
      		end
      		if punto_aux[0] < xPPerchDejada_array[1]:
         			xPPerchDejada_array[1] = punto_aux[0]
      		end
      		j = j + 1
      		punto_aux = P_Tipo2[j]
      		sleep(0.01)
  	end
  
  end
  
  if yPPerchDejada_min_array[1]<yPPerchDejada_min_array[0]:
