  		temp_tOFF_AVISO_SAI = 0					#Cambio RGR 23/11/2022, nuevo#
  	  else:								#Cambio RGR 23/11/2022, nuevo#
  		temp_tOFF_AVISO_SAI = temp_tOFF_AVISO_SAI + retraso	#Cambio RGR 23/11/2022, nuevo#
  		temp_tON_AVISO_SAI = 0					#Cambio RGR 23/11/2022, nuevo#
