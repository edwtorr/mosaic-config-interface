      $ 358 "LineaPreparada[1]=PalletOk[1] and LineaHabilitada[1] and (ProdListo or (not(CartonBase[1]) and NCapaAct[1]≟1 and NMovAct[1] ≟ 1 and Rec_Carton[0])  or  PonerCarton[1])"
      LineaPreparada[1]=PalletOk[1]  and  LineaHabilitada[1]  and  (ProdListo or (not(CartonBase[1])  and  NCapaAct[1] == 1 and NMovAct[1]  ==  1 and Rec_Carton[0])   or   PonerCarton[1])
