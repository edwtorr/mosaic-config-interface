  #FILTRADO ENTRADAS
  thread thread_filtrado():
  	while(True):
  
  	  #Lectura de entradas
  	  FT1_work = not(get_standard_digital_in(0))
  	  FT2_work = not(get_standard_digital_in(1))
  	  AVISO_SAI = get_standard_digital_in(2)
  	  FT4_work = not(get_standard_digital_in(3))
  	  FT5_work = get_standard_digital_in(4)
  	  QM1_work = not(get_standard_digital_in(7))
  	  VF1_work = get_configurable_digital_in(0)
  	  QM2_work = not(get_configurable_digital_in(6))
  	  VF2_work = get_configurable_digital_in(7)
  	  iVAC1 = get_tool_digital_in(0)
  	  iVAC2 = get_tool_digital_in(1)
  
  
  	  #FT1
  	  if (FT1_work):
  		temp_tON_FT1 = temp_tON_FT1 + retraso
  		temp_tOFF_FT1 = 0
  	  else:
  		temp_tOFF_FT1 = temp_tOFF_FT1 + retraso
  		temp_tON_FT1 = 0
  	  end
  
  	  if (temp_tON_FT1 > tON_FT1):
  		iFT1 =  True
  		temp_tON_FT1 = 0
  	  end
  
  	  if (temp_tOFF_FT1 > tOFF_FT1):
  		iFT1 =  False
  		temp_tOFF_FT1 = 0
  	  end
  
  	  #FT2
  	  if (FT2_work):
  		temp_tON_FT2 = temp_tON_FT2 + retraso
  		temp_tOFF_FT2 = 0
  	  else:
  		temp_tOFF_FT2 = temp_tOFF_FT2 + retraso
  		temp_tON_FT2 = 0
  	  end
  
  	  if (temp_tON_FT2 > tON_FT2):
  		iFT2 =  True
  		temp_tON_FT2 = 0
  	  end
  
  	  if (temp_tOFF_FT2 > tOFF_FT2):
  		iFT2 =  False
  		temp_tOFF_FT2 = 0
  	  end
  
  	  #Aviso_SAI
