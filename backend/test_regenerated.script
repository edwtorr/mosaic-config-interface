  #Función para la creación de un popup informativo que desaparece (y opcionalmente se aborta el Programa_1) tras un tiempo de espera
  def pop_up(mensaje, tiempo_espera, aborto):
  	socket_open("127.0.0.1",29999,"internal")
  	socket_send_string("popup " + mensaje, "internal")
  	socket_send_byte(10,"internal")
  
  	sleep(tiempo_espera)
  
  	socket_send_string("close popup", "internal")
  	socket_send_byte(10,"internal")
  
  	socket_close("internal")
  
  	if aborto == True:
  		halt
  	end
  
  end
  
  #Función que se usa para actualizar el TCP cuando hay cambio de peso, coordenadas o cog
  def setTCP(tool):
  
  	tool_tcp = p[tool[0]/1000, tool[1]/1000, tool[2]/1000, tool[3], tool[4], tool[5]]
  	mass = tool[6]/1000
  	cog = [tool[7]/1000, tool[8]/1000, tool[9]/1000]
  
  	set_tcp(tool_tcp)
  	set_payload(mass, cog)
  
  end
  
  
  #Funciones de movimiento respecto a un plano
  def MoveLTrans(p_destino, WorkObject, aceleracion, velocidad, tiempo, contorneo):
  
  	#El WorkObject debe tener la misma orientacion en Z que el TCP que vamos a utilizar
  	p_trans=pose_trans(WorkObject,p_destino)
  	movel(p_trans,aceleracion,velocidad,tiempo, contorneo)
  
  end
  
  
  def MoveJTrans(p_destino, WorkObject, aceleracion, velocidad, tiempo, contorneo):
  
  	#El WorkObject debe tener la misma orientacion en Z que el TCP que vamos a utilizar
  	p_trans=pose_trans(WorkObject,p_destino)
  	movej(p_trans,aceleracion,velocidad, tiempo, contorneo)
  
  end
  
  
  def MovePTrans(p_destino, WorkObject, aceleracion, velocidad, tiempo, contorneo):
  
  	#El WorkObject debe tener la misma orientacion en Z que el TCP que vamos a utilizar
  	p_trans=pose_trans(WorkObject,p_destino)
  	movep(p_trans,aceleracion,velocidad, tiempo, contorneo)
  
  end
  
  
  #Función de palet completo
  def palet_completo(lin):
  
  	PalletEnd[lin] = True
  	NCapaAct[lin] = 1
  	NPrdAct[lin] = 1
  	NMovAct[lin] = 1
  	NPaletAct = NPaletAct + 1
  	NPaletTot = NPaletTot + 1
  
  	if NPaletTot == 800000:
  		NPaletTot = 1
  	end
  
  	if NPaletAct == 800000:
  		NPaletAct = 1
  	end
  
  	pos_subida[lin] = 0
  	pos_bajada[lin] = 0
  
  end
